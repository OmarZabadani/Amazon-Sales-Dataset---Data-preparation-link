        "# ==========================================================\n",
        "# AMAZON SALES DATASET - VISUALIZATION\n",
        "# ==========================================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 1. Histogram\n",
        "# Rating Distribution\n",
        "# ===============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.hist(\n",
        "    data[\"rating\"],\n",
        "    bins=20\n",
        ")\n",
        "\n",
        "plt.title(\"Rating Distribution\")\n",
        "plt.xlabel(\"Rating\")\n",
        "plt.ylabel(\"Number of Products\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 2. Scatter Plot\n",
        "# Price vs Rating\n",
        "# ===============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.scatter(\n",
        "    data[\"discounted_price\"],\n",
        "    data[\"rating\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Discounted Price vs Rating\")\n",
        "plt.xlabel(\"Discounted Price\")\n",
        "plt.ylabel(\"Rating\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 3. Scatter Plot\n",
        "# Discount vs Rating Count\n",
        "# ===============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "plt.scatter(\n",
        "    data[\"discount_percentage\"],\n",
        "    data[\"rating_count\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Discount Percentage vs Rating Count\")\n",
        "plt.xlabel(\"Discount Percentage\")\n",
        "plt.ylabel(\"Rating Count\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 4. Bar Chart\n",
        "# Category vs Average Rating\n",
        "# ===============================\n",
        "\n",
        "category_rating = (\n",
        "    data.groupby(\"category\")[\"rating\"]\n",
        "    .mean()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "\n",
        "plt.figure(figsize=(12,6))\n",
        "\n",
        "category_rating.head(10).plot(\n",
        "    kind=\"bar\"\n",
        ")\n",
        "\n",
        "plt.title(\"Top Categories by Average Rating\")\n",
        "plt.xlabel(\"Category\")\n",
        "plt.ylabel(\"Average Rating\")\n",
        "\n",
        "plt.xticks(rotation=45)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 5. Box Plot\n",
        "# Price Distribution\n",
        "# ===============================\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "\n",
        "sns.boxplot(\n",
        "    x=data[\"discounted_price\"]\n",
        ")\n",
        "\n",
        "plt.title(\"Discounted Price Distribution\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "\n",
        "# ===============================\n",
        "# 6. Heatmap\n",
        "# Correlation Between Features\n",
        "# ===============================\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "\n",
        "\n",
        "correlation = data[\n",
        "    [\n",
        "        \"discounted_price\",\n",
        "        \"actual_price\",\n",
        "        \"discount_percentage\",\n",
        "        \"rating\",\n",
        "        \"rating_count\"\n",
        "    ]\n",
        "].corr()\n",
        "\n",
        "\n",
        "sns.heatmap(\n",
        "    correlation,\n",
        "    annot=True,\n",
        "    cmap=\"coolwarm\"\n",
        ")\n",
        "\n",
        "\n",
        "plt.title(\"Feature Correlation Heatmap\")\n",
        "\n",
        "plt.show()"
